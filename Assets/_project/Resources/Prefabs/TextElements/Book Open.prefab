--- !u!114 &4189156844631495591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5804520582963350569}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9366127076758c4d9758f83d75a66b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _textContent:
  - _loc: 0
    _content: "Chapitre-4 Enfin le savon.\n\nApr\xE8s avoir presque fini la d\xE9coration
      de sa cellule avec des bouts de v\xEAtements, Luste entendit un garde s'approcher.\nC'\xE9tait
      L\xE9on, le garde charg\xE9 de la distribution du repas pour chaque cellule.\nCette
      tourn\xE9e \xE9tait aussi celle de la distribution des savons pour chaque cellules.\nL\xE9on
      donna le plateau habituel \xE0 Luste mais cette fois en murmurant une seule
      phrase sans lever les yeux :"
  - _loc: 1
    _content: "<b>Chapter-4 Finally the soap.</b>\n\nAfter almost finishing the decoration
      of his cell with pieces of clothing, Luste heard a guard approaching.\nIt was
      Leon, the guard in charge of distributing the meal for each cell.\nThis tour
      was also the distribution of soaps for each cell.\nL\xE9on gave the usual tray
      to Luste but this time by whispering a single sentence without lifting his
      eyes: "
  _textOverride: {fileID: 0}
