--- !u!114 &1107578378
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1107578376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9366127076758c4d9758f83d75a66b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _textContent:
  - _loc: 0
    _content: "- Prend une douche, tu en a besoin.\nPuis il s\u2019\xE9loigna, laissant
      Luste seul avec le plateau. Ce dernier le ramassa, feignant l\u2019indiff\xE9rence.\nIl
      se recula dans l\u2019ombre de sa cellule et savoura son plateau repas avant
      d'ouvrir le savon emball\xE9 dans du papier toilette.\nLuste le trouva l\xE9g\xE8rement
      plus lourd que d'habitude, et l'observa avec plus d'attention.\nC'est alors
      qu'elle arriva \xE0 d\xE9cerner une cl\xE9 \xE0 l'int\xE9rieur."
  _textOverride: {fileID: 0}
