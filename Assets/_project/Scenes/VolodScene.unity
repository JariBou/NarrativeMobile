--- !u!114 &410594954
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 410594952}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Une nouvelle \xE9toile montante de la t\xE9l\xE9vision</b>\n\nLe journaliste
    Carl Morel remporte un nouveau prix de journalisme gr\xE2ce \xE0 son dernier
    reportage sur la Mafia am\xE9ricaine. Ce jeune auteur brille sur la sc\xE8ne
    t\xE9l\xE9vis\xE9e depuis maintenant quelque temps, et ne semble pas vouloir
    arr\xEAter son assencion. Le monde du journalisme accueille une nouvelle g\xE9n\xE9ration
    qui semble savoir quelle direction prendre.\nBonne chance \xE0 Mr.Morel, et qu\u2019il
    continue \xE0 faire briller le journalisme moderne."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
