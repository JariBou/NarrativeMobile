  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Chapitre-4 Enfin le savon.\n\nApr\xE8s avoir presque fini la d\xE9coration
    de sa cellule avec des bouts de v\xEAtements, Luste entendit un garde s'approcher.\nC'\xE9tait
    L\xE9on, le garde charg\xE9 de la distribution du repas pour chaque cellule.\nCette
    tourn\xE9e \xE9tait aussi celle de la distribution des savons pour chaque cellules.\nL\xE9on
    donna le plateau habituel \xE0 Luste mais cette fois en murmurant une seule phrase
    sans lever les yeux :\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
